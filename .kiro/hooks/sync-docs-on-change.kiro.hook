{
  "enabled": true,
  "name": "Sync Docs on Source Change",
  "description": "When Rust source files (.rs) or Cargo.toml are edited, asks the agent to review the change and update README.md and README.ru.md if the documentation is now out of date.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.rs",
      "Cargo.toml",
      "*.md"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file was just edited. Review the change and determine if README.md or README.ru.md need to be updated to reflect it. This includes CLI usage, features, dependencies, build instructions, or any user-facing behavior. If the docs are already accurate, do nothing. If they need updating, make the minimal edit to keep them in sync."
  },
  "workspaceFolderName": "RustShot",
  "shortName": "sync-docs-on-change"
}